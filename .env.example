# Copy to .env. Do not commit .env.
POSTGRES_DB=officecook
POSTGRES_USER=officecook
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5432
BACKEND_PORT=8000
APP_DOMAIN=cooking.example.com
APP_ORIGIN=https://cooking.example.com
APP_HTTPS_PORT=443
APP_VERSION=dev
BUILD_DATE=unknown
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OFFICE_COOK_ZENMONEY_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
OFFICE_COOK_ZENMONEY_SYNC_INTERVAL_MINUTES=15
BACKEND_IMAGE=officecooking-backend:local
FRONTEND_IMAGE=officecooking-frontend:local
